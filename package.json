{
  "name": "oerba-desktop",
  "version": "0.3.1",
  "description": "Oerba Desktop: a hardened Electron shell around Oerba, opening on a setup screen that walks a person in.",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "build:app": "npm run typecheck && node scripts/build.mjs --app",
    "pack:unsigned": "bash scripts/pack-unsigned.sh",
    "verify:pack": "bash scripts/verify-pack.sh"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "electron": "44.10.0",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "typescript": "6.0.3"
  }
}
